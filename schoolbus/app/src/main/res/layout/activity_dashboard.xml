<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#E8721C"
        app:title="School Bus"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHello"
                android:text="Hola, Usuario"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#222222"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvRole"
                android:text="CONDUCTOR"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:layout_marginBottom="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnMap"
                style="@style/Widget.MaterialComponents.Button"
                android:text="▶  Iniciar ruta"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E8721C"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnStudents"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Ver estudiantes"
                android:textColor="#E8721C"
                android:backgroundTint="#FFFFFF"
                app:strokeColor="#E8721C"
                app:strokeWidth="2dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textSize="16sp"
                android:layout_marginBottom="24dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5C842">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:alpha="0.6"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvRouteStatus"
                        android:text="Sin ruta asignada"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FDF0E8"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemTextColor="@color/bottom_nav_tint"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>